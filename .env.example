DATABASE_URL=postgresql+psycopg://auraltrans:auraltrans@localhost:5432/auraltrans
STORAGE_BACKEND=local
STORAGE_PATH=./data
HF_TOKEN=
# Product pipeline (worker). tiny is quick for trying things out; use cuda/float16 on a GPU.
ASR_MODEL=small
ASR_DEVICE=cpu
ASR_COMPUTE_TYPE=int8
MAX_UPLOAD_MB=500
# OpenAI-compatible endpoint: Groq, Hugging Face router, or Ollama
LLM_PROVIDER=openai_compat
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=
